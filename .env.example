# Copy to .env and edit. docker compose reads this file automatically.
# Everything here maps 1:1 to a --flag in `python3 stt_proxy.py --help`.

# ---- host ------------------------------------------------------------------
# Port published on the host (the container always listens on 8765).
STT_PROXY_HOST_PORT=8765

# ---- upstream --------------------------------------------------------------
STT_PROXY_UPSTREAM=https://api.openai.com
STT_PROXY_PATH=/v1/audio/transcriptions

# The proxy's own credential. Leave EMPTY to let every client pass its own
# Authorization header through instead.
STT_PROXY_API_KEY=

STT_PROXY_UPSTREAM_TIMEOUT=300

# ---- ffmpeg target shape ---------------------------------------------------
# 16000 Hz / mono / pcm_s16le is what Whisper-class models expect.
STT_PROXY_SAMPLE_RATE=16000
STT_PROXY_CHANNELS=1
STT_PROXY_CODEC=pcm_s16le
# 1 = skip ffmpeg when the upload is already exactly the target WAV shape.
STT_PROXY_PASSTHROUGH_WAV=0
STT_PROXY_FFMPEG_TIMEOUT=180

# ---- limits ----------------------------------------------------------------
STT_PROXY_MAX_UPLOAD_MB=200
STT_PROXY_THREADS=8
STT_PROXY_TMPFS_MB=1024
STT_PROXY_LOG_LEVEL=info
